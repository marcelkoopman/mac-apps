<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copycraft privacy manifest. Shipped as Contents/Resources/PrivacyInfo.xcprivacy through
  `resources` in apps/copycraft/Cargo.toml; checked by scripts/check_privacy_manifest.sh and by
  apps/copycraft/tests/privacy_manifest.rs.
  No tracking, no collected data: Copycraft is offline and sends nothing anywhere.
  Required-reason APIs actually used (found by reading the sources, std and dependencies):
  - UserDefaults CA92.1: the app's own settings (src/settings.rs) and appearance
    (mac_ui::theme), read and written in its own defaults domain only.
  - FileTimestamp C617.1: std::fs::metadata (stat) on its own files in the app container
    (preview files in the temporary directory, src/macos_open.rs).
  - FileTimestamp 3B52.1: stat on files the user chose with the open panel, dropped on the
    card or copied (src/open_file.rs, src/macos_pasteboard.rs).
  - SystemBootTime 35F9.1: std::time::Instant (macOS: monotonic uptime clock) to measure time
    elapsed between events inside the app (menu bar, tray blink, hotkey timing).
  Not used: disk space (no statvfs, no volume capacity keys; sysinfo is in the tree through
  polars-utils but without its disk feature) and active keyboard APIs (the latter is a UIKit
  list; winit's TISCopyCurrentKeyboardLayoutInputSource is not on it).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
