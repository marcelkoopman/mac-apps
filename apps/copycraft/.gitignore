# =====================================================================
# 1. RUST & CARGO (Cruciaal voor Grok Build token-besparing)
# =====================================================================
# Voorkomt dat Grok de gigantische gecompileerde code en binaries leest
/target/
debug/

# Back-up bestanden van rustfmt negeren
**/*.rs.bk

# Logbestanden van Cargo
cargo-crash.log

# =====================================================================
# 2. MACOS SPECIFIEK (Voorkomt onnodige scans van OS metadata)
# =====================================================================
# Algemene macOS systeembestanden
.DS_Store
.AppleDouble
.LSOverride

# Iconen en metadata mappen
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Xcode & Swift mappen (als je native macOS bindings gebruikt)
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcscmblueprint
*.xcuserstate

# =====================================================================
# 3. IDE'S & EDITORS (Indien van toepassing)
# =====================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / RustRover / CLion
.idea/
