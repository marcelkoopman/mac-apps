<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copycraft App Sandbox entitlements. Applied by `codesign ... entitlements` in
  .github/workflows/release-copycraft.yml and scripts/sign_app.sh.
  - app-sandbox: required for the Mac App Store.
  - network.client: link / YouTube previews via NSURLConnection
    (src/macos_fetch.rs:74, called from src/macos_launcher.rs:1875-1904).
  - files.user-selected.read-write: "Choose file" NSOpenPanel (src/macos_open.rs:10)
    and "Save" NSSavePanel + std::fs::write (src/macos_save.rs:12, :30).
  Not needed: NSPasteboard (clipboard), Carbon global hotkey (global-hotkey crate),
  Vision OCR, NSUserDefaults, opening a URL in the browser.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
